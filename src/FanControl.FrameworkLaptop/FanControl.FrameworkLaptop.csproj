<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>FanControl.FrameworkLaptop</AssemblyName>
    <RootNamespace>FanControl.FrameworkLaptop</RootNamespace>
    <Version>2.0.0</Version>
    <Product>FanControl.FrameworkLaptop</Product>
    <Description>FanControl-Plugin für Framework-Laptops (direkt über den CrosEC-Treiber, Rückfall framework_tool)</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- Wird von FanControl selbst mitgebracht, daher nicht mitkopieren -->
    <Reference Include="FanControl.Plugins">
      <HintPath>lib\FanControl.Plugins.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
